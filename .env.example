# demo uses the versioned local catalogue and a deterministic Nightshift response.
# live requires both sponsor services and never falls back to another provider.
APP_MODE=demo
FRONTEND_ORIGIN=http://localhost:5173

# Zetaris direct REST API, normally forwarded privately from the Codespace.
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Meterless Runtime values from the Nightshift Console. The NVIDIA key belongs
# only in Nightshift's Providers tab and must never be added here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP_ID=unipilot
# Set true only after a Nightshift receipt proves this route used the Nemotron lane.
METERLESS_NEMOTRON_ROUTE_CONFIRMED=false

# Generate a long random local value. Contracts are signed even in development.
SCOUT_SIGNING_SECRET=
